# ============================================================
# Elora / Sniper — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to source control.
# ============================================================

# ---- General ----
ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/moneybanque.log

# ---- Solana RPC (Helius / QuickNode) ----
SOLANA_RPC_URL=
SOLANA_RPC_URL_BACKUP=
SOLANA_NETWORK=mainnet
RPC_TIMEOUT=10
RPC_MAX_RETRIES=5
# Helius priority fee level: Min / Low / Medium / High / VeryHigh / UnsafeMax
PRIORITY_FEE_LEVEL=High
# Priority fee cap (microlamports per compute unit)
MAX_PRIORITY_FEE_MICROLAMPORTS=500000

# ---- PumpPortal (Method 2 — Local Transaction API) ----
# Elora meme wallet (XVYG) — creator / fee payer for meme launches (local signing only)
PUMPPORTAL_WALLET_PRIVATE_KEY=
# Only needed when SNIPER_WATCH_PCT > 0 (metered subscribeTokenTrade stream).
# Must be a valid pumpportal.fun API key whose wallet holds at least 0.02 SOL.
PUMPPORTAL_API_KEY=

# ---- Pinata IPFS (token image + metadata) ----
PINATA_JWT=

# ---- Elora meme launches (manual only: scripts/launch_meme.py) ----
INITIAL_BUY_SOL=0.02
LAUNCH_SLIPPAGE_PCT=10

# ---- Pre-Scope & Terminal Sniper ----
SNIPER_ENABLED=true
# Dedicated sniper wallet (required) — separate from the Elora meme wallet
SNIPER_WALLET_PRIVATE_KEY=
# % of (balance - reserve) per trade so profits compound; 0 = fixed SNIPER_BUY_SOL.
# Starting value 10 (approved by Kevin). Raise only after the trade journal shows net profit.
SNIPER_BALANCE_PCT=10
SNIPER_RESERVE_SOL=0.03
# Loss limit: no new buys while wallet SOL + open positions is below this (0 = off)
SNIPER_MIN_BALANCE_SOL=0
# Fixed trade size when SNIPER_BALANCE_PCT=0, otherwise the minimum trade size
SNIPER_BUY_SOL=0.05
SNIPER_PRESCOPE_PCT=72
SNIPER_BUY_MIN_PCT=76
SNIPER_BUY_MAX_PCT=86
# Sell when the bonding curve reaches this %. 0 = off (P&L take-profit only).
SNIPER_SELL_CURVE_PCT=86
# Buy filters against bundled / instant-pump launches: token must have been pre-scoped first,
# be at least N seconds old, and its curve must still be rising at the buy read
SNIPER_REQUIRE_PRESCOPE=true
SNIPER_MIN_TOKEN_AGE_SECONDS=60
SNIPER_REQUIRE_RISING=true
# Skip tokens whose curve climbed more than N points within the window (pump-and-dump). 0 = off.
SNIPER_MAX_RISE_PCT=8
SNIPER_RISE_WINDOW_SECONDS=10
# Position P&L % (live sell value vs. SOL spent) — NOT bonding curve levels. Confirmed by Kevin.
SNIPER_TAKE_PROFIT_PCT=85
SNIPER_STOP_LOSS_PCT=15
SNIPER_EXIT_ON_MIGRATION=true
SNIPER_MAX_HOLD_SECONDS=900
SNIPER_BUY_SLIPPAGE_PCT=10
SNIPER_SELL_SLIPPAGE_PCT=15
# All tracked bonding curves are read via RPC every N seconds (1 Helius credit per 100 tokens)
SNIPER_SCAN_INTERVAL_SECONDS=5
# Curve % at which a token also gets the real-time PumpPortal trade stream
# (needs PUMPPORTAL_API_KEY, 0.01 SOL per 10k events). 0 = off, RPC scans only.
SNIPER_WATCH_PCT=0
# Stop tracking a token whose curve has not moved for N seconds
SNIPER_TRACK_IDLE_SECONDS=180
# Open positions are saved here so a restart keeps managing them
SNIPER_STATE_FILE=logs/sniper_positions.json
# In-flight buy/sell signatures awaiting confirmation (F02 pending ledger)
SNIPER_PENDING_FILE=logs/sniper_pending.json
# Trade journal (JSON lines): signals, missed opportunities, fills, fees, slippage, net P&L
SNIPER_TRADE_LOG=logs/sniper_trades.jsonl
# F04 — single-instance locks (prevents stacked workers on restart)
SNIPER_LOCK_FILE=logs/sniper.lock
ELORA_LOCK_FILE=logs/elora.lock

# ---- Trade pool (Kevin self-buy wallets; NOT wash/fake volume) ----
# Generate once: python scripts/generate_trade_pool_wallets.py
TRADE_POOL_WALLETS_FILE=secrets/trade_pool_wallets.json
TRADE_POOL_STATE_FILE=logs/trade_pool_state.json
TRADE_POOL_SOL_PER_WALLET=0.12
TRADE_POOL_BUY_SOL=0.10
TRADE_POOL_BUY_SLIPPAGE_PCT=10
TRADE_POOL_STAGGER_SECONDS=1.5
# Fail-closed — also require: python scripts/trade_pool_ctl.py enable <tier>
TRADE_POOL_TIER_10_ENABLED=false
TRADE_POOL_TIER_20_ENABLED=false
TRADE_POOL_TIER_50_ENABLED=false
TRADE_POOL_TIER_100_ENABLED=false
# Kevin mint only (required for --live buys)
TRADE_POOL_ALLOWED_MINT=

# ---- Audit scripts ----
LYC_TOKEN_MINT=HJjWmTp5bR4YYKpCtVW9nJ4qmoL9AgqL6JnNJEYW9nBm

# ---- Telegram (@allorameme) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Sniper alerts only. Empty = TELEGRAM_CHANNEL_ID. Bot must be an admin of this channel.
SNIPER_TELEGRAM_CHANNEL_ID=

# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ---- Marketing (campaigns: MARKETING_CAMPAIGNS_FILE) ----
# X app: bearer token for search, consumer key/secret for posting
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
# One token pair per posting account named in campaigns.json ("account": "ELORA")
X_ELORA_ACCESS_TOKEN=
X_ELORA_ACCESS_TOKEN_SECRET=
MARKETING_ENABLED=false
# true = Telegram previews only, nothing is posted. false = posts after admin approval.
MARKETING_DRY_RUN=true
MARKETING_CAMPAIGNS_FILE=marketing/campaigns.json
MARKETING_STATE_FILE=logs/marketing_seen.json
MARKETING_POLL_INTERVAL=900
MARKETING_MAX_POSTS=3
MARKETING_APPROVAL_TIMEOUT_MINUTES=60
# Optional LLM hooks — falls back to campaign hooks if empty
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
